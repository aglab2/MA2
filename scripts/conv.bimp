#BIMP 2.6
#MANIPULATION SET DEFINITION

[CHANGEFORMAT]
format=4
interlace=false
compression=9
savebgc=true
savegamma=false
saveoff=false
savephys=true
savetime=true
savecomm=true
savetrans=true

[RESIZE]
new_w_pc=100
new_h_pc=100
new_w_px=64
new_h_px=64
resize_mode_width=1
resize_mode_height=1
stretch_mode=0
padding_color=#000000000000
padding_color_alpha=65535
interpolation=0
change_res=false
new_res_x=72
new_res_y=72

[USERDEF0]
procedure=gimp-image-convert-indexed
num_params=7
PARAM0=NOT_USED
PARAM1=0
PARAM2=0
PARAM3=16
PARAM4=0
PARAM5=0
PARAM6=
